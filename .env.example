# Copy to .env and fill in real values. .env is gitignored.
# Obtain these from Google Cloud Console > APIs & Services > Credentials
# after enabling the Business Profile APIs and requesting access:
#   https://developers.google.com/my-business/content/prereqs
GBP_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GBP_CLIENT_SECRET=your-oauth-client-secret
GBP_REFRESH_TOKEN=your-refresh-token

# Optional: override default token endpoint (almost never needed)
# GBP_TOKEN_URI=https://oauth2.googleapis.com/token

# Optional: pin the account/location you operate on
# GBP_ACCOUNT_ID=accounts/1234567890
